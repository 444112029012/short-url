# SHORTURL 環境變數範本（無真實機密；複製為 .env 後本機填值）
# 詳見 docs/09-cicd-env/02-environments-v0.1.md、03-secrets-management-v0.1.md

APP_ENV=local
HTTP_ADDR=:8080
DATABASE_PATH=./data/shorturl.local.db
BASE_URL=http://localhost:8080
RATE_LIMIT_CREATE_PER_MIN=30
RATE_LIMIT_REDIRECT_PER_MIN=120
# TRUSTED_PROXY_CIDRS=
